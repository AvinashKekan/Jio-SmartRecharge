generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String                @id @default(cuid())
  name         String
  email        String                @unique
  passwordHash String
  createdAt    DateTime              @default(now())
  transactions RechargeTransaction[]
  preferences  CustomerPreference?
}

model PlanCategory {
  id    String         @id @default(cuid())
  name  String         @unique
  slug  String         @unique
  plans RechargePlan[]
}

model RechargePlan {
  id               String                @id @default(cuid())
  name             String
  price            Int
  validityDays     Int
  dailyDataGB      Float?
  totalDataGB      Float?
  voiceAllowance   String
  smsAllowance     String
  networkType      String
  supports5G       Boolean               @default(false)
  promotionalLabel String?
  benefits         Json
  notes            Json
  terms            String
  sourceType       String                @default("ILLUSTRATIVE")
  sourceUrl        String?
  lastVerifiedAt   DateTime?
  isDemoData       Boolean               @default(true)
  isActive         Boolean               @default(true)
  categoryId       String
  category         PlanCategory          @relation(fields: [categoryId], references: [id])
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  transactions     RechargeTransaction[]

  @@index([categoryId, isActive])
  @@index([price, validityDays])
}

model CustomerPreference {
  id                String   @id @default(cuid())
  userId            String   @unique
  dailyUsageGB      Float    @default(2)
  monthlyBudget     Int      @default(500)
  preferredValidity Int      @default(28)
  requires5G        Boolean  @default(false)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RechargeTransaction {
  id            String       @id @default(cuid())
  reference     String       @unique
  userId        String
  planId        String
  mobileNumber  String
  amount        Int
  status        String       @default("SUCCESS")
  paymentMethod String
  createdAt     DateTime     @default(now())
  expiryAt      DateTime
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan          RechargePlan @relation(fields: [planId], references: [id])

  @@index([userId, createdAt])
}
