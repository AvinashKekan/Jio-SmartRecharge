{
  "name": "smart-recharge",
  "private": true,
  "version": "2.0.0",
  "workspaces": ["server"],
  "scripts": {
    "dev": "concurrently \"npm run dev -w server\" \"http-server client -p 5173 -c-1\"",
    "build": "npm run build -w server",
    "test": "npm run test -w server",
    "db:generate": "npm run db:generate -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "http-server": "^14.1.1"
  }
}
